{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${authors}"
  ],
  "contributors": [
    "${contributors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "icon": "assets/${modId}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.syrupstudios.wellseasoned.wellseasoned.java"
    ]
  },
  "depends": {
    "fabricloader": ">=${fl}",
    "minecraft": ">=${mc}",
    "fabric-api": "${fapi}"
  },
  "mixins": [
    "${modId}.mixins.json"
  ]
}
